# Copy to .env and edit. Everything except the two passwords has a working default.

# The first server admin is created from these on first start (password: 10+ characters).
MP_ADMIN_EMAIL=admin@studio.example
MP_ADMIN_PASSWORD=
# Name of the organization created with the first admin.
MP_DEFAULT_ORG="My Studio"

# Database password (used by both the server and Postgres).
POSTGRES_PASSWORD=

# The address people use to reach this server; used in invite links.
MP_PUBLIC_URL=http://localhost:18500
MP_PORT=18500

# Where file data lives: local (Docker volume), mount (host folder or network share), or s3.
MP_STORAGE=local
# For MP_STORAGE=mount: the host folder to use, e.g. /mnt/nas/multiparity
# MP_BLOB_DIR=/mnt/nas/multiparity

# Reaching the server from outside the office (docs/REMOTE.md).
# With `docker compose --profile https up -d`: the name people type, and an email for a real
# certificate (or "internal" to test with Caddy's own certificate).
# MP_DOMAIN=mp.yourstudio.com
# MP_TLS=you@yourstudio.com
# Then also set MP_PUBLIC_URL=https://mp.yourstudio.com, MP_CLIENT_IP_HEADER=X-Forwarded-For
# and MP_BIND=127.0.0.1. Behind a Cloudflare tunnel instead: MP_CLIENT_IP_HEADER=CF-Connecting-IP.
MP_CLIENT_IP_HEADER=

# Projects this big (GB) or bigger keep people's checkpoints on the server instead of on their
# computers, unless the project is set otherwise in Admin > Projects.
MP_SERVER_CHECKPOINTS_FROM_GB=20

# More storage locations, so different projects can keep their data in different places (the
# one above is called "main"). Space- or comma-separated, each name=kind:details:
#   local or mount: a folder inside the container (add a volume line for it in
#     docker-compose.override.yml, e.g. - /mnt/nas/mp:/data/nas)
#   s3: bucket=...;endpoint=...;region=...;prefix=...  with credentials in
#     MP_STORAGE_<NAME>_ACCESS_KEY_ID and MP_STORAGE_<NAME>_SECRET_ACCESS_KEY
# Choose a project's location when creating it, or move it later in Admin > Projects.
# MP_STORAGE_LOCATIONS="nas=mount:/data/nas archive=s3:bucket=mp-archive;endpoint=https://<account>.r2.cloudflarestorage.com;region=auto"
# MP_STORAGE_ARCHIVE_ACCESS_KEY_ID=
# MP_STORAGE_ARCHIVE_SECRET_ACCESS_KEY=

# For MP_STORAGE=s3 (AWS, MinIO, Cloudflare R2, Backblaze B2, Wasabi ...).
# With `docker compose --profile s3 up -d` a bundled MinIO is started; then use:
#   MP_S3_ENDPOINT=http://minio:9000
MP_S3_BUCKET=multiparity
MP_S3_ENDPOINT=
MP_S3_REGION=us-east-1
MP_S3_PREFIX=
AWS_ACCESS_KEY_ID=multiparity
AWS_SECRET_ACCESS_KEY=
